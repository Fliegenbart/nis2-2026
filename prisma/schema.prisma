generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  consultant
  reviewer
  client_readonly
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum ActionPriority {
  critical
  high
  medium
  low
}

enum ActionStatus {
  open
  in_progress
  blocked
  done
}

enum FindingStatus {
  draft
  in_review
  approved
  closed
}

enum FindingSeverity {
  critical
  high
  medium
  low
}

enum FindingCommentRole {
  consultant
  reviewer
  client
}

enum ComplianceProgramStatus {
  setup_in_progress
  blocked
  final_review
  continuous_compliance
  completed
}

enum ComplianceProgramPhase {
  assessment
  gap_review
  roadmap
  policies
  controls
  training
  final_review
  continuous_compliance
}

enum DocumentType {
  information_security_policy
  access_control_policy
  incident_response_policy
  backup_policy
  vendor_security_policy
  cyber_hygiene_handbook
  incident_communication_plan
}

enum DocumentStatus {
  generated
  customer_input_needed
  expert_review_needed
  legal_review_needed
  approved
  published
}

enum TrainingCampaignType {
  security_basics
  phishing_awareness
  incident_reporting
  password_security
  sensitive_data_handling
  management_cybersecurity_briefing
}

enum TrainingCampaignStatus {
  planned
  active
  completed
  overdue
}

enum TrainingAssignmentStatus {
  pending
  invited
  in_progress
  completed
  overdue
}

enum ReviewCaseType {
  legal
  security_expert
  management_signoff
}

enum ReviewCaseStatus {
  open
  in_progress
  resolved
  dismissed
}

enum ReviewCaseDecision {
  approved
  changes_required
  escalated
  rejected
  no_action
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  clients Client[]
  audits  Audit[]
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           UserRole @default(consultant)
  companyName    String?
  logoUrl        String?
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  audits               Audit[]
  createdFindings      Finding[]              @relation("FindingCreatedBy")
  reviewedFindings     Finding[]              @relation("FindingReviewedBy")
  reviewOwnedFindings  Finding[]              @relation("FindingReviewOwner")
  findingComments      FindingComment[]       @relation("FindingCommentAuthor")
  findingStatusChanges FindingStatusHistory[] @relation("FindingStatusChangedBy")
  ownedActionItems     ActionItem[]           @relation("ActionOwner")
  ownedCompliancePrograms ComplianceProgram[] @relation("ComplianceProgramOwner")
  editedDocumentArtifacts DocumentArtifact[]  @relation("DocumentEditedBy")
  assignedReviewCases     ReviewCase[]        @relation("ReviewCaseAssignedTo")
  reviewedReviewCases     ReviewCase[]        @relation("ReviewCaseReviewedBy")
}

model Audit {
  id                 String     @id @default(uuid())
  companyName        String?
  revenue            Float?
  employeeCount      Int?
  industry           String?
  locale             String     @default("de")
  isPremium          Boolean    @default(false)
  frameworkVersion   String     @default("nis2-2026-v1")
  methodologyVersion String     @default("methodology-v1")
  isLocked           Boolean    @default(false)
  lockedAt           DateTime?
  overallScore       Int?
  riskLevel          RiskLevel?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName     String?
  clientLogo     String?

  answers         Answer[]
  lead            Lead?
  evidences       Evidence[]
  actionItems     ActionItem[]
  findings        Finding[]
  reportSnapshots AuditSnapshot[]
  complianceProgram ComplianceProgram?
  documentPackage   DocumentPackage?
  documentArtifacts DocumentArtifact[]
  trainingCampaigns TrainingCampaign[]
  reviewCases       ReviewCase[]

  @@index([frameworkVersion])
  @@index([organizationId, clientId])
}

model Lead {
  id          String   @id @default(uuid())
  email       String
  companyName String?
  consent     Boolean  @default(false)
  source      String   @default("quick-check")
  createdAt   DateTime @default(now())

  auditId String @unique
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

model Answer {
  id         String   @id @default(uuid())
  questionId String
  categoryId String
  value      String
  notes      String?
  updatedAt  DateTime @updatedAt

  auditId String
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, questionId])
}

model Evidence {
  id         String   @id @default(uuid())
  filename   String
  url        String
  mimeType   String?
  uploadedAt DateTime @default(now())

  auditId    String
  audit      Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  questionId String

  @@index([auditId, questionId])
}

model ActionItem {
  id          String         @id @default(uuid())
  title       String
  description String?
  priority    ActionPriority @default(medium)
  status      ActionStatus   @default(open)
  dueDate     DateTime?
  ownerName   String?
  ownerEmail  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  auditId     String
  audit       Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  questionId  String?
  categoryId  String?
  ownerUserId String?
  ownerUser   User?    @relation("ActionOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  findingId   String?
  finding     Finding? @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([auditId, status, priority])
  @@index([findingId])
}

model Finding {
  id                String          @id @default(uuid())
  title             String
  description       String?
  severity          FindingSeverity @default(medium)
  status            FindingStatus   @default(draft)
  dueDate           DateTime?
  approvedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  auditId           String
  questionId        String?
  categoryId        String?
  createdByUserId   String?
  reviewedByUserId  String?
  reviewOwnerUserId String?

  audit            Audit                    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  createdBy        User?                    @relation("FindingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy       User?                    @relation("FindingReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewOwner      User?                    @relation("FindingReviewOwner", fields: [reviewOwnerUserId], references: [id], onDelete: SetNull)
  comments         FindingComment[]
  actionItems      ActionItem[]
  statusHistory    FindingStatusHistory[]
  escalationEvents FindingEscalationEvent[]

  @@index([auditId, status])
  @@index([auditId, severity])
  @@index([reviewOwnerUserId, status])
}

model FindingComment {
  id           String             @id @default(uuid())
  body         String
  authorRole   FindingCommentRole @default(consultant)
  authorName   String?
  createdAt    DateTime           @default(now())
  findingId    String
  authorUserId String?

  finding    Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  authorUser User?   @relation("FindingCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([findingId, createdAt])
}

model FindingStatusHistory {
  id              String         @id @default(uuid())
  findingId       String
  fromStatus      FindingStatus?
  toStatus        FindingStatus
  changedByUserId String?
  note            String?
  metadata        Json?
  createdAt       DateTime       @default(now())

  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("FindingStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([findingId, createdAt])
  @@index([createdAt])
}

model FindingEscalationEvent {
  id              String        @id @default(uuid())
  findingId       String
  channel         String
  deliveryTarget  String
  escalationDate  DateTime
  escalatedAt     DateTime      @default(now())
  statusSnapshot  FindingStatus
  dueDateSnapshot DateTime?
  success         Boolean       @default(false)
  responseStatus  Int?
  errorMessage    String?
  payload         Json
  fingerprint     String        @unique

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId, escalatedAt])
  @@index([escalationDate])
}

model ComplianceProgram {
  id           String                  @id @default(uuid())
  auditId      String                  @unique
  status       ComplianceProgramStatus @default(setup_in_progress)
  currentPhase ComplianceProgramPhase  @default(assessment)
  currentWeek  Int                     @default(1)
  startDate    DateTime                @default(now())
  targetDate   DateTime
  completedAt  DateTime?
  ownerUserId  String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  audit            Audit             @relation(fields: [auditId], references: [id], onDelete: Cascade)
  owner            User?             @relation("ComplianceProgramOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  documentPackage  DocumentPackage?
  trainingCampaigns TrainingCampaign[]
  reviewCases      ReviewCase[]

  @@index([status, currentPhase])
  @@index([ownerUserId, status])
}

model DocumentPackage {
  id        String         @id @default(uuid())
  auditId   String         @unique
  programId String?        @unique
  status    DocumentStatus @default(generated)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  audit     Audit              @relation(fields: [auditId], references: [id], onDelete: Cascade)
  program   ComplianceProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  artifacts DocumentArtifact[]
}

model DocumentArtifact {
  id               String         @id @default(uuid())
  documentPackageId String
  auditId          String
  type             DocumentType
  title            String
  status           DocumentStatus @default(generated)
  templateVersion  String         @default("v1")
  generatedContent String
  customContent    String?
  lastGeneratedAt  DateTime       @default(now())
  approvedAt       DateTime?
  publishedAt      DateTime?
  lastEditedByUserId String?
  manualEditsCount Int            @default(0)
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  documentPackage       DocumentPackage @relation(fields: [documentPackageId], references: [id], onDelete: Cascade)
  audit                 Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  lastEditedBy          User?           @relation("DocumentEditedBy", fields: [lastEditedByUserId], references: [id], onDelete: SetNull)
  reviewCases           ReviewCase[]

  @@unique([documentPackageId, type])
  @@index([auditId, status])
  @@index([type, status])
}

model TrainingCampaign {
  id             String               @id @default(uuid())
  auditId        String
  programId      String?
  type           TrainingCampaignType
  title          String
  targetGroup    String
  status         TrainingCampaignStatus @default(planned)
  isMandatory    Boolean              @default(true)
  dueDate        DateTime?
  lastReminderAt DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  audit       Audit              @relation(fields: [auditId], references: [id], onDelete: Cascade)
  program     ComplianceProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  assignments TrainingAssignment[]
  reviewCases ReviewCase[]

  @@unique([auditId, type])
  @@index([auditId, status])
  @@index([dueDate, status])
}

model TrainingAssignment {
  id                String                 @id @default(uuid())
  campaignId        String
  participantLabel  String
  participantEmail  String?
  status            TrainingAssignmentStatus @default(pending)
  completionPercent Int                    @default(0)
  quizScore         Int?
  invitedAt         DateTime?
  reminderSentAt    DateTime?
  dueDate           DateTime?
  completedAt       DateTime?
  metadata          Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  campaign    TrainingCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  certificate TrainingCertificate?

  @@index([campaignId, status])
}

model TrainingCertificate {
  id                String   @id @default(uuid())
  assignmentId      String   @unique
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
  url               String?
  payload           Json?

  assignment TrainingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model ReviewCase {
  id                       String             @id @default(uuid())
  auditId                  String
  programId                String?
  type                     ReviewCaseType
  status                   ReviewCaseStatus   @default(open)
  decision                 ReviewCaseDecision?
  title                    String
  triggerReason            String
  details                  String?
  source                   String
  fingerprint              String             @unique
  affectedDocumentArtifactId String?
  affectedTrainingCampaignId String?
  reviewedByUserId         String?
  assignedToUserId         String?
  reviewedAt               DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  audit                  Audit              @relation(fields: [auditId], references: [id], onDelete: Cascade)
  program                ComplianceProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  affectedDocumentArtifact DocumentArtifact? @relation(fields: [affectedDocumentArtifactId], references: [id], onDelete: SetNull)
  affectedTrainingCampaign TrainingCampaign? @relation(fields: [affectedTrainingCampaignId], references: [id], onDelete: SetNull)
  reviewedBy             User?              @relation("ReviewCaseReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  assignedTo             User?              @relation("ReviewCaseAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([auditId, status])
  @@index([type, status])
  @@index([assignedToUserId, status])
}

model Client {
  id             String   @id @default(uuid())
  name           String
  companyName    String?
  industry       String?
  logoUrl        String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audits       Audit[]

  @@index([organizationId, name])
}

model ControlCatalog {
  id                 String   @id @default(uuid())
  frameworkVersion   String
  methodologyVersion String
  categoryId         String
  questionId         String
  severity           String
  weight             Int
  articleRef         String
  legalReference     String
  evidenceRequired   Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([frameworkVersion, questionId])
  @@index([frameworkVersion, categoryId])
}

model AuditSnapshot {
  id                 String    @id @default(uuid())
  auditId            String
  frameworkVersion   String
  methodologyVersion String
  overallScore       Int
  riskLevel          RiskLevel
  payload            Json
  createdAt          DateTime  @default(now())

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, createdAt])
}
