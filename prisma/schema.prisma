generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("consultant")
  companyName  String?
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  audits Audit[]
}

model Audit {
  id            String   @id @default(uuid())
  companyName   String?
  revenue       Float?
  employeeCount Int?
  industry      String?
  locale        String   @default("de")
  isPremium     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId     String?
  user       User?   @relation(fields: [userId], references: [id])
  clientName String?
  clientLogo String?

  answers     Answer[]
  lead        Lead?
  evidences   Evidence[]
  actionItems ActionItem[]
}

model Lead {
  id          String   @id @default(uuid())
  email       String
  companyName String?
  consent     Boolean  @default(false)
  source      String   @default("quick-check")
  createdAt   DateTime @default(now())

  auditId String @unique
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

model Answer {
  id         String   @id @default(uuid())
  questionId String
  categoryId String
  value      String
  notes      String?
  updatedAt  DateTime @updatedAt

  auditId String
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, questionId])
}

model Evidence {
  id         String   @id @default(uuid())
  filename   String
  url        String
  mimeType   String?
  uploadedAt DateTime @default(now())

  auditId    String
  audit      Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  questionId String

  @@index([auditId, questionId])
}

model ActionItem {
  id          String    @id @default(uuid())
  title       String
  description String?
  priority    String    @default("medium")
  status      String    @default("open")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  auditId    String
  audit      Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  questionId String?
  categoryId String?
}
